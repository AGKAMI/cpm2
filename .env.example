# NAMES ONLY — copy to .env.local and fill in real values. Never commit secrets.
# Local development only; Vercel holds its own Preview/Production copies.

# Shared Turso database (fleet console + VANTA GARAGE store)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Encryption. CPM2_ENCRYPTION_KEY is REQUIRED on Vercel/production;
# locally the app generates and persists a 32-byte key at CPM2_KEY_PATH.
CPM2_KEY_PATH=data/.secret-key
CPM2_ENCRYPTION_KEY=
ACCOUNT_ENCRYPTION_KEY=
CPM2_BCRYPT_ROUNDS=12

# Console + Telegram Mini App
APP_PASSWORD=
STORE_OWNER_EMAIL=
CONSOLE_OWNER_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
STORE_ADMIN_TELEGRAM_ID=

# Scheduled maintenance: /api/store/internal/cron (Vercel Cron sends Bearer)
CRON_SECRET=

# Storefront payments
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
PAYFAST_BASE_URL=
STARS_ZAR_PER_STAR=

# Public links and notifications
NEXT_PUBLIC_SITE_URL=
VANTA_WHATSAPP_WEBHOOK_URL=
VANTA_WHATSAPP_WEBHOOK_SECRET=
GEMINI_API_KEY=
